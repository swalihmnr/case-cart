<%- include('../partials/header') %>
<div class="flex">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-4 lg:p-8 min-h-screen bg-gray-50 overflow-y-auto">
    <!-- Page Header -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-blue-100 text-blue-600 font-bold text-sm">
            <i class="fas fa-sliders-h"></i>
          </span>
          <h1 class="text-2xl lg:text-3xl font-extrabold text-gray-900 tracking-tight">Homepage Controls</h1>
        </div>
        <p class="text-gray-500 text-sm mt-1">Configure live homepage components: announcement ticker, hero sale banner, and chatbot.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 shadow-sm transition">
          <i class="fas fa-external-link-alt text-gray-400"></i> View Live Store
        </a>
      </div>
    </div>

    <!-- Alert notifications -->
    <% if (success && success.length > 0) { %>
      <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl flex items-center gap-3 text-sm font-medium shadow-sm">
        <i class="fas fa-check-circle text-emerald-500 text-lg"></i>
        <span><%= success %></span>
      </div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl flex items-center gap-3 text-sm font-medium shadow-sm">
        <i class="fas fa-exclamation-circle text-rose-500 text-lg"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Main Grid: Settings Cards -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

      <!-- Left 2 Cols: Main Settings Form -->
      <div class="xl:col-span-2 space-y-6">

        <form action="/admin/homepage-settings" method="POST" enctype="multipart/form-data" class="space-y-6">

          <!-- CARD 1: Announcement / Product Ticker -->
          <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                  <i class="fas fa-bullhorn"></i>
                </div>
                <div>
                  <h2 class="text-base font-bold text-gray-900">Marquee / Running Ticker</h2>
                  <p class="text-xs text-gray-500">The scrolling strip below the search bar on the homepage</p>
                </div>
              </div>

              <!-- Master Ticker Toggle -->
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="tickerEnabled" class="sr-only peer" <%= settings.ticker.isEnabled ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                <span class="ml-2 text-xs font-semibold text-gray-600">Active</span>
              </label>
            </div>

            <div class="p-5 sm:p-6 space-y-5">
              <!-- Speed Slider -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="text-xs font-bold text-gray-700 uppercase tracking-wider">Animation Speed (Seconds per cycle)</label>
                  <span id="speedValueLabel" class="text-xs font-extrabold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full"><%= settings.ticker.speed || 30 %>s</span>
                </div>
                <input type="range" name="tickerSpeed" min="10" max="90" step="5" value="<%= settings.ticker.speed || 30 %>"
                       class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
                       id="speedRange"
                       oninput="document.getElementById('speedValueLabel').innerText = this.value + 's'">
                <div class="flex justify-between text-[11px] text-gray-400 mt-1">
                  <span>Fast (10s)</span>
                  <span>Normal (30s)</span>
                  <span>Slow (90s)</span>
                </div>
              </div>

              <!-- Sources Checkboxes -->
              <div class="pt-2 border-t border-gray-100">
                <label class="text-xs font-bold text-gray-700 uppercase tracking-wider block mb-3">Automatic Content Feeds</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <label class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 hover:bg-gray-50/80 cursor-pointer transition">
                    <input type="checkbox" name="showProducts" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" <%= settings.ticker.showProducts ? 'checked' : '' %>>
                    <div>
                      <div class="text-xs font-bold text-gray-800">Show Latest Products</div>
                      <div class="text-[11px] text-gray-500">Pulls names & prices from active store catalog</div>
                    </div>
                  </label>

                  <label class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 hover:bg-gray-50/80 cursor-pointer transition">
                    <input type="checkbox" name="showCategories" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" <%= settings.ticker.showCategories ? 'checked' : '' %>>
                    <div>
                      <div class="text-xs font-bold text-gray-800">Show Categories</div>
                      <div class="text-[11px] text-gray-500">Displays active category chips in ticker</div>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 2: Hero Sale Banner -->
          <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                  <i class="fas fa-tags"></i>
                </div>
                <div>
                  <h2 class="text-base font-bold text-gray-900">Hero Sale Banner</h2>
                  <p class="text-xs text-gray-500">Main promotional banner below the ticker (Custom Graphic or Gradient)</p>
                </div>
              </div>

              <!-- Hero Toggle -->
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="heroEnabled" class="sr-only peer" <%= settings.heroBanner?.isEnabled ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                <span class="ml-2 text-xs font-semibold text-gray-600">Active</span>
              </label>
            </div>

            <div class="p-5 sm:p-6 space-y-5">
              <!-- Banner Mode Selection -->
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2.5">Banner Type / Design Mode</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <!-- Option 1: Custom Image Banner -->
                  <label class="relative flex items-center gap-3 p-3.5 rounded-xl border-2 cursor-pointer transition <%= (settings.heroBanner?.bannerType === 'custom_image' || settings.heroBanner?.customImage?.url) ? 'border-amber-500 bg-amber-50/40 text-amber-900' : 'border-gray-200 hover:border-gray-300 bg-white text-gray-700' %>" id="modeCustomImageLabel">
                    <input type="radio" name="heroBannerType" value="custom_image" class="w-4 h-4 text-amber-600 focus:ring-amber-500" <%= (settings.heroBanner?.bannerType === 'custom_image' || settings.heroBanner?.customImage?.url) ? 'checked' : '' %> onchange="switchBannerMode('custom_image')">
                    <div>
                      <div class="text-xs font-bold flex items-center gap-1.5">
                        <i class="fas fa-file-image text-amber-600"></i>
                        <span>Custom Designed Image Banner</span>
                      </div>
                      <div class="text-[11px] text-gray-500 mt-0.5">Upload custom PNG/JPG banner designed from Photoshop at any custom size</div>
                    </div>
                  </label>

                  <!-- Option 2: Gradient & Text -->
                  <label class="relative flex items-center gap-3 p-3.5 rounded-xl border-2 cursor-pointer transition <%= (settings.heroBanner?.bannerType === 'gradient_text' && !settings.heroBanner?.customImage?.url) ? 'border-amber-500 bg-amber-50/40 text-amber-900' : 'border-gray-200 hover:border-gray-300 bg-white text-gray-700' %>" id="modeGradientTextLabel">
                    <input type="radio" name="heroBannerType" value="gradient_text" class="w-4 h-4 text-amber-600 focus:ring-amber-500" <%= (settings.heroBanner?.bannerType === 'gradient_text' && !settings.heroBanner?.customImage?.url) ? 'checked' : '' %> onchange="switchBannerMode('gradient_text')">
                    <div>
                      <div class="text-xs font-bold flex items-center gap-1.5">
                        <i class="fas fa-layer-group text-blue-600"></i>
                        <span>Dynamic Gradient & Text</span>
                      </div>
                      <div class="text-[11px] text-gray-500 mt-0.5">Flipkart-style HTML typography banner with badge, buttons and glow</div>
                    </div>
                  </label>
                </div>
              </div>

              <!-- ============================================ -->
              <!-- PANEL A: CUSTOM IMAGE BANNER CONFIGURATION -->
              <!-- ============================================ -->
              <div id="customImagePanel" class="space-y-4 pt-3 border-t border-gray-100 <%= (settings.heroBanner?.bannerType === 'custom_image' || settings.heroBanner?.customImage?.url) ? '' : 'hidden' %>">
                <div class="bg-amber-50/70 p-4 rounded-xl border border-amber-200/80">
                  <div class="flex items-center gap-2 mb-2 text-amber-900 text-xs font-bold">
                    <i class="fas fa-palette text-amber-600"></i>
                    <span>Custom Graphic Banner (Photoshop, Canva, PNG, JPG, WEBP)</span>
                  </div>
                  <p class="text-xs text-amber-800/90 leading-relaxed">
                    Upload your high-resolution banner. You can choose <strong>Natural / Auto Height</strong> to display the exact aspect ratio of your design without any cropping or distortion.
                  </p>
                </div>

                <!-- Existing Banner Preview -->
                <% if (settings.heroBanner?.customImage?.url) { %>
                  <div class="p-4 rounded-xl border border-gray-200 bg-gray-50">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Current Live Banner</span>
                      <div class="flex items-center gap-2">
                        <a href="<%= settings.heroBanner.customImage.url %>" target="_blank" class="text-xs text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center gap-1">
                          <i class="fas fa-external-link-alt text-[10px]"></i> View Full Size
                        </a>
                        <button type="submit" formaction="/admin/homepage-settings/banner/delete-image" onclick="return confirm('Remove this custom banner image?');" class="text-xs text-red-600 hover:text-red-700 font-semibold inline-flex items-center gap-1 ml-2">
                          <i class="fas fa-trash-alt text-[10px]"></i> Remove Image
                        </button>
                      </div>
                    </div>
                    <div class="w-full rounded-lg overflow-hidden border border-gray-200 bg-gray-900 flex items-center justify-center max-h-48">
                      <img src="<%= settings.heroBanner.customImage.url %>" alt="Current Banner" class="w-full max-h-48 object-contain">
                    </div>
                  </div>
                <% } %>

                <!-- File Upload Box -->
                <div>
                  <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    <%= settings.heroBanner?.customImage?.url ? 'Replace Banner Image' : 'Upload Banner Image (PNG, JPG, WEBP)' %>
                  </label>
                  <input type="file" name="bannerImage" id="bannerImageInput" accept="image/*" class="hidden" onchange="previewBannerFile(this)">
                  
                  <div onclick="document.getElementById('bannerImageInput').click()"
                       class="border-2 border-dashed border-gray-300 hover:border-amber-500 rounded-2xl p-6 text-center transition-colors cursor-pointer bg-gray-50/50 hover:bg-amber-50/30 group">
                    <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center group-hover:scale-110 transition">
                      <i class="fas fa-cloud-arrow-up text-xl"></i>
                    </div>
                    <p class="text-sm font-bold text-gray-800">Click to select banner from computer</p>
                    <p class="text-xs text-gray-500 mt-0.5">Supports Photoshop exports, PNG, JPG, WEBP up to 10MB</p>
                  </div>

                  <!-- Live File Selection Preview -->
                  <div id="bannerFilePreviewContainer" class="hidden mt-3 p-3 bg-gray-50 border border-gray-200 rounded-xl">
                    <p class="text-xs font-bold text-gray-700 mb-2 flex items-center gap-1.5">
                      <i class="fas fa-eye text-amber-600"></i>
                      <span>Selected Image Preview:</span>
                      <span id="bannerFileName" class="text-gray-500 font-normal truncate"></span>
                    </p>
                    <div class="w-full rounded-lg overflow-hidden border border-gray-200 bg-gray-900 flex items-center justify-center max-h-48">
                      <img id="bannerFilePreviewImg" src="" alt="Selected Preview" class="w-full max-h-48 object-contain">
                    </div>
                  </div>
                </div>

                <!-- Banner Custom Sizing / Aspect Ratio & Fit -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                      Banner Sizing / Aspect Ratio
                    </label>
                    <select name="bannerAspectRatio" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition">
                      <option value="auto" <%= (settings.heroBanner?.aspectRatio === 'auto' || !settings.heroBanner?.aspectRatio) ? 'selected' : '' %>>
                        📐 Natural / Auto Height (Preserves exact Photoshop dimensions)
                      </option>
                      <option value="21/9" <%= settings.heroBanner?.aspectRatio === '21/9' ? 'selected' : '' %>>
                        🎬 Cinematic Ultra-wide (21:9)
                      </option>
                      <option value="16/9" <%= settings.heroBanner?.aspectRatio === '16/9' ? 'selected' : '' %>>
                        🖥️ Standard Widescreen (16:9)
                      </option>
                      <option value="3/1" <%= settings.heroBanner?.aspectRatio === '3/1' ? 'selected' : '' %>>
                        🏷️ Hero Strip (3:1)
                      </option>
                      <option value="4/1" <%= settings.heroBanner?.aspectRatio === '4/1' ? 'selected' : '' %>>
                        📏 Compact Panorama Strip (4:1)
                      </option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                      Image Fit & Scaling
                    </label>
                    <select name="bannerFitMode" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition">
                      <option value="cover" <%= (settings.heroBanner?.fitMode === 'cover' || !settings.heroBanner?.fitMode) ? 'selected' : '' %>>
                        Cover (Fills container cleanly)
                      </option>
                      <option value="contain" <%= settings.heroBanner?.fitMode === 'contain' ? 'selected' : '' %>>
                        Contain (Fit full artwork with no clipping)
                      </option>
                      <option value="fill" <%= settings.heroBanner?.fitMode === 'fill' ? 'selected' : '' %>>
                        Fill (Stretch to boundary)
                      </option>
                    </select>
                  </div>
                </div>

                <!-- Click Target & Alt text -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Banner Click-Through Link</label>
                    <input type="text" name="bannerImageLink" value="<%= settings.heroBanner?.imageLink || '/product' %>" placeholder="e.g. /product or /offers"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Image Alt Text (SEO)</label>
                    <input type="text" name="bannerImageAlt" value="<%= settings.heroBanner?.imageAlt || 'Promotional Sale Banner' %>" placeholder="e.g. Big Festive Sale Banner"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-amber-500 focus:outline-none transition">
                  </div>
                </div>
              </div>

              <!-- ============================================ -->
              <!-- PANEL B: DYNAMIC GRADIENT & TEXT CONFIGURATION -->
              <!-- ============================================ -->
              <div id="gradientTextPanel" class="space-y-4 pt-3 border-t border-gray-100 <%= (settings.heroBanner?.bannerType === 'gradient_text' && !settings.heroBanner?.customImage?.url) ? '' : 'hidden' %>">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Badge Tag</label>
                    <input type="text" name="heroBadge" value="<%= settings.heroBanner?.badge || 'BIG SAVING DAYS' %>"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Main Heading</label>
                    <input type="text" name="heroHeading" value="<%= settings.heroBanner?.heading || 'Up to 80% Off' %>"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Subtext / Highlights</label>
                  <input type="text" name="heroSubtext" value="<%= settings.heroBanner?.subtext || '' %>"
                         placeholder="e.g. Top Cases, Leather Accessories & MagSafe Essentials at Unbeatable Prices."
                         class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Button Label</label>
                    <input type="text" name="heroCtaText" value="<%= settings.heroBanner?.ctaText || 'Shop Now' %>"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Button URL</label>
                    <input type="text" name="heroCtaLink" value="<%= settings.heroBanner?.ctaLink || '/product' %>"
                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 3: AI Chatbot Controls -->
          <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
                  <i class="fas fa-robot"></i>
                </div>
                <div>
                  <h2 class="text-base font-bold text-gray-900">CaseCart AI Chatbot Widget</h2>
                  <p class="text-xs text-gray-500">Floating help button and customer assistant window</p>
                </div>
              </div>

              <!-- Chatbot Toggle -->
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="chatbotEnabled" class="sr-only peer" <%= settings.chatbot?.isEnabled ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                <span class="ml-2 text-xs font-semibold text-gray-600">Active</span>
              </label>
            </div>

            <div class="p-5 sm:p-6">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Bot Greeting Message</label>
              <textarea name="chatbotGreeting" rows="2"
                        class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-purple-500 focus:outline-none transition"><%= settings.chatbot?.greeting || "👋 Hi! I'm CaseCart's AI assistant.\nHow can I help you today?" %></textarea>
              <p class="text-[11px] text-gray-400 mt-1">Displayed as the opening message when a customer launches the chat widget.</p>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="flex items-center justify-end gap-3 pt-2">
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform active:scale-95">
              <i class="fas fa-save"></i> Save All Changes
            </button>
          </div>
        </form>

      </div>

      <!-- Right Col: Custom Ticker Announcements Manager -->
      <div class="space-y-6">

        <!-- Add Custom Ticker Item Box -->
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-5 sm:p-6">
          <div class="flex items-center gap-2 mb-4">
            <i class="fas fa-plus-circle text-blue-600"></i>
            <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">Add Custom Ticker Item</h3>
          </div>

          <form action="/admin/homepage-settings/ticker/add" method="POST" class="space-y-3">
            <div>
              <label class="block text-[11px] font-bold text-gray-600 uppercase mb-1">Announcement Text *</label>
              <input type="text" name="text" required placeholder="e.g. ⚡ Free Delivery on orders over ₹499"
                     class="w-full px-3 py-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-bold text-gray-600 uppercase mb-1">Target URL</label>
                <input type="text" name="link" value="/product" placeholder="/product"
                       class="w-full px-3 py-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-[11px] font-bold text-gray-600 uppercase mb-1">Type Tag</label>
                <select name="type" class="w-full px-3 py-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
                  <option value="promo">🎉 Promotion</option>
                  <option value="product">📦 Product</option>
                  <option value="category">🏷️ Category</option>
                </select>
              </div>
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-gray-900 hover:bg-black text-white text-xs font-bold rounded-lg transition shadow-sm flex items-center justify-center gap-2">
              <i class="fas fa-plus"></i> Add to Ticker
            </button>
          </form>
        </div>

        <!-- Current Custom Items List -->
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-5 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">Custom Items</h3>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">
              <%= settings.ticker?.customItems ? settings.ticker.customItems.length : 0 %> items
            </span>
          </div>

          <% if (settings.ticker?.customItems && settings.ticker.customItems.length > 0) { %>
            <div class="divide-y divide-gray-100 max-h-[460px] overflow-y-auto pr-1">
              <% settings.ticker.customItems.forEach(item => { %>
                <div class="py-3 flex items-center justify-between gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-[10px] uppercase font-extrabold px-1.5 py-0.5 rounded-md
                        <%= item.type === 'promo' ? 'bg-amber-100 text-amber-800' : (item.type === 'category' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800') %>">
                        <%= item.type %>
                      </span>
                      <span class="text-[11px] text-gray-400 truncate max-w-[120px]"><%= item.link %></span>
                    </div>
                    <p class="text-xs font-medium text-gray-800 break-words <%= !item.isActive ? 'line-through text-gray-400' : '' %>">
                      <%= item.text %>
                    </p>
                  </div>

                  <div class="flex items-center gap-2 flex-shrink-0">
                    <!-- Toggle Active Switch via fetch -->
                    <button type="button"
                            onclick="toggleItem('<%= item._id %>', this)"
                            title="Toggle Visibility"
                            class="p-1.5 rounded-lg border text-xs transition <%= item.isActive ? 'bg-emerald-50 text-emerald-600 border-emerald-200 hover:bg-emerald-100' : 'bg-gray-100 text-gray-400 border-gray-200 hover:bg-gray-200' %>">
                      <i class="fas <%= item.isActive ? 'fa-eye' : 'fa-eye-slash' %>"></i>
                    </button>

                    <!-- Delete Form -->
                    <form action="/admin/homepage-settings/ticker/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Delete this ticker item?');">
                      <button type="submit" title="Delete" class="p-1.5 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 text-xs transition">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="py-8 text-center text-gray-400">
              <i class="fas fa-inbox text-3xl mb-2 text-gray-300"></i>
              <p class="text-xs">No custom ticker announcements added yet.</p>
              <p class="text-[11px] text-gray-400 mt-1">Add custom promos, free shipping notices, or coupon alerts above.</p>
            </div>
          <% } %>
        </div>

        <!-- Quick Help Card -->
        <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-2xl p-5 text-white shadow-md">
          <div class="flex items-center gap-2 mb-2">
            <i class="fas fa-info-circle text-blue-200"></i>
            <h4 class="text-xs font-bold uppercase tracking-wider text-blue-100">Pro Tip</h4>
          </div>
          <p class="text-xs text-blue-100 leading-relaxed">
            Changes saved here update immediately on the customer storefront. You can pause or hide any item anytime without deleting it.
          </p>
        </div>

      </div>

    </div>

  </main>
</div>

<script>
function switchBannerMode(mode) {
  const customPanel = document.getElementById('customImagePanel');
  const gradientPanel = document.getElementById('gradientTextPanel');
  const customLabel = document.getElementById('modeCustomImageLabel');
  const gradientLabel = document.getElementById('modeGradientTextLabel');

  if (mode === 'custom_image') {
    if (customPanel) customPanel.classList.remove('hidden');
    if (gradientPanel) gradientPanel.classList.add('hidden');

    if (customLabel) {
      customLabel.classList.add('border-amber-500', 'bg-amber-50/40', 'text-amber-900');
      customLabel.classList.remove('border-gray-200', 'bg-white', 'text-gray-700');
    }
    if (gradientLabel) {
      gradientLabel.classList.remove('border-amber-500', 'bg-amber-50/40', 'text-amber-900');
      gradientLabel.classList.add('border-gray-200', 'bg-white', 'text-gray-700');
    }
  } else {
    if (customPanel) customPanel.classList.add('hidden');
    if (gradientPanel) gradientPanel.classList.remove('hidden');

    if (gradientLabel) {
      gradientLabel.classList.add('border-amber-500', 'bg-amber-50/40', 'text-amber-900');
      gradientLabel.classList.remove('border-gray-200', 'bg-white', 'text-gray-700');
    }
    if (customLabel) {
      customLabel.classList.remove('border-amber-500', 'bg-amber-50/40', 'text-amber-900');
      customLabel.classList.add('border-gray-200', 'bg-white', 'text-gray-700');
    }
  }
}

function previewBannerFile(input) {
  const file = input.files && input.files[0];
  const container = document.getElementById('bannerFilePreviewContainer');
  const img = document.getElementById('bannerFilePreviewImg');
  const nameEl = document.getElementById('bannerFileName');

  if (file && img && container) {
    nameEl.textContent = `(${file.name} - ${(file.size / 1024 / 1024).toFixed(2)} MB)`;
    const reader = new FileReader();
    reader.onload = function (e) {
      img.src = e.target.result;
      container.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }
}

async function toggleItem(itemId, btn) {
  try {
    const res = await fetch(`/admin/homepage-settings/ticker/toggle/${itemId}`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      window.location.reload();
    }
  } catch (e) {
    console.error(e);
  }
}
</script>

<%- include('../partials/footer') %>
