    <!-- ===== CaseCart AI Chatbot Widget ===== -->

    <!-- Floating Toggle Button -->
    <button id="cc-chat-toggle"
            onclick="ccChatToggle()"
            aria-label="Open chat"
            style="position:fixed;bottom:28px;right:28px;z-index:9999;width:56px;height:56px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#2874f0,#1e40af);box-shadow:0 4px 20px rgba(40,116,240,0.5);transition:transform .2s,box-shadow .2s;">
        <i id="cc-chat-icon" class="fas fa-comment-dots" style="color:#fff;font-size:22px;transition:transform .3s;"></i>
        <!-- Unread dot -->
        <span id="cc-unread-dot" style="position:absolute;top:6px;right:6px;width:10px;height:10px;background:#ff4444;border-radius:50%;border:2px solid #fff;display:block;"></span>
    </button>

    <!-- Chat Window -->
    <div id="cc-chat-window"
         style="position:fixed;bottom:96px;right:28px;z-index:9998;width:360px;max-width:calc(100vw - 40px);height:520px;max-height:calc(100vh - 120px);border-radius:20px;overflow:hidden;display:none;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);transform:translateY(20px) scale(0.97);opacity:0;transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease;font-family:'Inter',sans-serif;">

        <!-- Header -->
        <div style="background:linear-gradient(135deg,#2874f0 0%,#1e40af 100%);padding:16px 18px;display:flex;align-items:center;gap:12px;flex-shrink:0;">
            <div style="width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-robot" style="color:#fff;font-size:18px;"></i>
            </div>
            <div style="flex:1;min-width:0;">
                <div style="color:#fff;font-weight:700;font-size:14px;line-height:1.2;">CaseCart Assistant</div>
                <div style="display:flex;align-items:center;gap:5px;margin-top:2px;">
                    <span style="width:7px;height:7px;border-radius:50%;background:#4ade80;display:inline-block;"></span>
                    <span style="color:rgba(255,255,255,0.75);font-size:11px;font-weight:500;">Online · Usually replies instantly</span>
                </div>
            </div>
            <button onclick="ccChatToggle()" style="background:rgba(255,255,255,0.15);border:none;border-radius:50%;width:30px;height:30px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s;" onmouseover="this.style.background='rgba(255,255,255,0.25)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
                <i class="fas fa-times" style="color:#fff;font-size:13px;"></i>
            </button>
        </div>

        <!-- Messages Area -->
        <div id="cc-messages"
             style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;background:#f8fafc;scroll-behavior:smooth;">

            <!-- Bot welcome message -->
            <div class="cc-msg cc-bot" style="display:flex;align-items:flex-end;gap:8px;">
                <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#2874f0,#1e40af);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-bottom:2px;">
                    <i class="fas fa-robot" style="color:#fff;font-size:12px;"></i>
                </div>
                <div style="max-width:75%;">
                    <div style="background:#fff;border:1px solid #e2e8f0;padding:10px 14px;border-radius:18px 18px 18px 4px;font-size:13px;color:#1e293b;line-height:1.5;box-shadow:0 1px 4px rgba(0,0,0,0.06);">
                        👋 Hi! I'm CaseCart's AI assistant.<br>How can I help you today?
                    </div>
                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;padding-left:4px;">Just now</div>
                </div>
            </div>

        </div>

        <!-- Quick Replies -->
        <div id="cc-quick-replies" style="padding:10px 14px 0;background:#f8fafc;display:flex;flex-wrap:wrap;gap:7px;flex-shrink:0;">
            <button onclick="ccQuickReply(this,'Track my order')" class="cc-qr-btn">📦 Track my order</button>
            <button onclick="ccQuickReply(this,'Return policy')" class="cc-qr-btn">↩️ Return policy</button>
            <button onclick="ccQuickReply(this,'Best selling cases')" class="cc-qr-btn">🏆 Best sellers</button>
            <button onclick="ccQuickReply(this,'Payment options')" class="cc-qr-btn">💳 Payment options</button>
            <button onclick="ccQuickReply(this,'Contact support')" class="cc-qr-btn">🙋 Contact support</button>
        </div>

        <!-- Input Bar -->
        <div style="padding:12px 14px;background:#fff;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px;flex-shrink:0;">
            <input id="cc-input"
                   type="text"
                   placeholder="Type a message…"
                   onkeydown="if(event.key==='Enter')ccSendMessage()"
                   style="flex:1;border:1.5px solid #e2e8f0;border-radius:24px;padding:9px 16px;font-size:13px;color:#1e293b;outline:none;background:#f8fafc;transition:border-color .2s;font-family:inherit;"
                   onfocus="this.style.borderColor='#2874f0'"
                   onblur="this.style.borderColor='#e2e8f0'">
            <button onclick="ccSendMessage()"
                    style="width:38px;height:38px;border-radius:50%;border:none;background:linear-gradient(135deg,#2874f0,#1e40af);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .15s,box-shadow .15s;box-shadow:0 2px 8px rgba(40,116,240,0.4);"
                    onmouseover="this.style.transform='scale(1.08)'"
                    onmouseout="this.style.transform='scale(1)'">
                <i class="fas fa-paper-plane" style="color:#fff;font-size:13px;margin-left:1px;"></i>
            </button>
        </div>
    </div>

    <!-- Chatbot Styles -->
    <style>
        .cc-qr-btn {
            background: #fff;
            border: 1.5px solid #e2e8f0;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 11.5px;
            font-weight: 600;
            color: #2874f0;
            cursor: pointer;
            transition: background .15s, border-color .15s, transform .1s;
            font-family: inherit;
            white-space: nowrap;
        }
        .cc-qr-btn:hover {
            background: #eff6ff;
            border-color: #2874f0;
            transform: translateY(-1px);
        }
        #cc-messages::-webkit-scrollbar { width: 4px; }
        #cc-messages::-webkit-scrollbar-track { background: transparent; }
        #cc-messages::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        @keyframes cc-typing-dot {
            0%, 80%, 100% { transform: scale(0.7); opacity: .4; }
            40% { transform: scale(1); opacity: 1; }
        }
        /* Dark mode overrides */
        body:not(.light-theme) #cc-chat-window {
            box-shadow: 0 20px 60px rgba(0,0,0,0.6) !important;
        }
        body:not(.light-theme) #cc-messages {
            background: #0f172a !important;
        }
        body:not(.light-theme) #cc-messages .cc-bot > div:last-child > div:first-child {
            background: #1e293b !important;
            border-color: #334155 !important;
            color: #e2e8f0 !important;
        }
        body:not(.light-theme) #cc-quick-replies {
            background: #0f172a !important;
        }
        body:not(.light-theme) .cc-qr-btn {
            background: #1e293b !important;
            border-color: #334155 !important;
            color: #60a5fa !important;
        }
        body:not(.light-theme) .cc-qr-btn:hover {
            background: #1e3a5f !important;
            border-color: #2874f0 !important;
        }
        body:not(.light-theme) #cc-input {
            background: #1e293b !important;
            border-color: #334155 !important;
            color: #e2e8f0 !important;
        }
        body:not(.light-theme) #cc-input::placeholder { color: #64748b !important; }
        body:not(.light-theme) div[style*="background:#fff;border-top"] {
            background: #1e293b !important;
            border-color: #334155 !important;
        }

        /* User bubble color */
        .cc-user-bubble {
            background: linear-gradient(135deg, #2874f0, #1e40af);
            color: #fff;
            padding: 10px 14px;
            border-radius: 18px 18px 4px 18px;
            font-size: 13px;
            line-height: 1.5;
            max-width: 75%;
            box-shadow: 0 2px 8px rgba(40,116,240,0.3);
        }
    </style>

    <!-- Chatbot Script -->
    <script>
    (function() {
        const BOT_RESPONSES = {
            'track my order':    '📦 To track your order, go to <strong>My Account → Orders</strong> and click your order to see real-time status updates.',
            'return policy':     '↩️ We offer <strong>7-day hassle-free returns</strong> on most items. Visit <strong>My Orders</strong> and click "Return" on the item you want to return.',
            'best selling cases':'🏆 Our top picks right now are the <strong>Carbon Fiber Series</strong>, <strong>MagSafe Leather Folio</strong>, and the <strong>Transparent Futuristic Case</strong>. <a href="/product" style="color:#2874f0;font-weight:600;">Browse all →</a>',
            'payment options':   '💳 We accept <strong>UPI, Net Banking, Credit/Debit cards</strong>, and <strong>Razorpay</strong>. All payments are 100% secure and encrypted.',
            'contact support':   '🙋 Reach us at <strong>support@casecart.in</strong> or call <strong>+91-9876543210</strong> (Mon–Sat, 9 AM – 6 PM).',
        };

        let isOpen = false;

        window.ccChatToggle = function() {
            const win = document.getElementById('cc-chat-window');
            const dot = document.getElementById('cc-unread-dot');
            const icon = document.getElementById('cc-chat-icon');
            isOpen = !isOpen;

            if (isOpen) {
                win.style.display = 'flex';
                dot.style.display = 'none';
                setTimeout(() => {
                    win.style.transform = 'translateY(0) scale(1)';
                    win.style.opacity = '1';
                }, 10);
                icon.className = 'fas fa-times';
                icon.style.fontSize = '18px';
            } else {
                win.style.transform = 'translateY(20px) scale(0.97)';
                win.style.opacity = '0';
                setTimeout(() => { win.style.display = 'none'; }, 280);
                icon.className = 'fas fa-comment-dots';
                icon.style.fontSize = '22px';
            }
        };

        window.ccSendMessage = function() {
            const input = document.getElementById('cc-input');
            const text = input.value.trim();
            if (!text) return;
            input.value = '';
            ccAppendUser(text);
            ccShowTyping();
            const key = text.toLowerCase().replace(/[^a-z ]/g,'');
            const response = BOT_RESPONSES[key] || "Thanks for reaching out! 😊 A support agent will get back to you shortly. In the meantime, feel free to <a href='/product' style='color:#2874f0;font-weight:600;'>browse our products →</a>";
            setTimeout(() => {
                ccHideTyping();
                ccAppendBot(response);
            }, 1000 + Math.random() * 600);
        };

        window.ccQuickReply = function(btn, text) {
            btn.disabled = true;
            btn.style.opacity = '0.5';
            ccAppendUser(text);
            ccShowTyping();
            const key = text.toLowerCase();
            const response = BOT_RESPONSES[key] || "I'm looking into that for you right now! 🔍";
            setTimeout(() => {
                ccHideTyping();
                ccAppendBot(response);
            }, 900 + Math.random() * 500);
        };

        function ccAppendUser(text) {
            const msgs = document.getElementById('cc-messages');
            const wrap = document.createElement('div');
            wrap.style.cssText = 'display:flex;justify-content:flex-end;';
            wrap.innerHTML = `
                <div style="display:flex;flex-direction:column;align-items:flex-end;max-width:80%;">
                    <div class="cc-user-bubble">${ccEscape(text)}</div>
                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;padding-right:4px;">You · just now</div>
                </div>`;
            msgs.appendChild(wrap);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function ccAppendBot(html) {
            const msgs = document.getElementById('cc-messages');
            const isDark = !document.body.classList.contains('light-theme');
            const bubbleBg = isDark ? '#1e293b' : '#fff';
            const bubbleBorder = isDark ? '#334155' : '#e2e8f0';
            const bubbleColor = isDark ? '#e2e8f0' : '#1e293b';
            const wrap = document.createElement('div');
            wrap.className = 'cc-msg cc-bot';
            wrap.style.cssText = 'display:flex;align-items:flex-end;gap:8px;';
            wrap.innerHTML = `
                <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#2874f0,#1e40af);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-bottom:2px;">
                    <i class="fas fa-robot" style="color:#fff;font-size:12px;"></i>
                </div>
                <div style="max-width:75%;">
                    <div style="background:${bubbleBg};border:1px solid ${bubbleBorder};padding:10px 14px;border-radius:18px 18px 18px 4px;font-size:13px;color:${bubbleColor};line-height:1.5;box-shadow:0 1px 4px rgba(0,0,0,0.06);">${html}</div>
                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;padding-left:4px;">Just now</div>
                </div>`;
            msgs.appendChild(wrap);
            msgs.scrollTop = msgs.scrollHeight;
        }

        let typingEl = null;
        function ccShowTyping() {
            const msgs = document.getElementById('cc-messages');
            const isDark = !document.body.classList.contains('light-theme');
            typingEl = document.createElement('div');
            typingEl.id = 'cc-typing';
            typingEl.className = 'cc-msg cc-bot';
            typingEl.style.cssText = 'display:flex;align-items:flex-end;gap:8px;';
            typingEl.innerHTML = `
                <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#2874f0,#1e40af);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="fas fa-robot" style="color:#fff;font-size:12px;"></i>
                </div>
                <div style="background:${isDark?'#1e293b':'#fff'};border:1px solid ${isDark?'#334155':'#e2e8f0'};padding:12px 16px;border-radius:18px 18px 18px 4px;display:flex;gap:5px;align-items:center;box-shadow:0 1px 4px rgba(0,0,0,0.06);">
                    <span style="width:7px;height:7px;border-radius:50%;background:#94a3b8;display:inline-block;animation:cc-typing-dot 1.2s infinite ease-in-out;animation-delay:0s;"></span>
                    <span style="width:7px;height:7px;border-radius:50%;background:#94a3b8;display:inline-block;animation:cc-typing-dot 1.2s infinite ease-in-out;animation-delay:.2s;"></span>
                    <span style="width:7px;height:7px;border-radius:50%;background:#94a3b8;display:inline-block;animation:cc-typing-dot 1.2s infinite ease-in-out;animation-delay:.4s;"></span>
                </div>`;
            msgs.appendChild(typingEl);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function ccHideTyping() {
            if (typingEl) { typingEl.remove(); typingEl = null; }
        }

        function ccEscape(str) {
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        // Pulse the button after 3s to draw attention
        setTimeout(() => {
            const btn = document.getElementById('cc-chat-toggle');
            if (btn) {
                btn.style.transform = 'scale(1.15)';
                btn.style.boxShadow = '0 4px 30px rgba(40,116,240,0.7)';
                setTimeout(() => {
                    btn.style.transform = 'scale(1)';
                    btn.style.boxShadow = '0 4px 20px rgba(40,116,240,0.5)';
                }, 400);
            }
        }, 3000);
    })();
    </script>

</body>
</html>