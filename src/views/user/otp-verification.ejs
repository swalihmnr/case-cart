<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - CaseCart</title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&family=Inter:wght@300;400;500;600&display=swap');
        
        .otp-input {
            width: 48px;
            height: 52px;
            text-align: center;
            font-size: 22px;
            font-weight: 600;
            color: #F7F5F2;
            background-color: #0A0A0A;
            border: 1px solid rgba(232, 213, 176, 0.15);
            border-radius: 12px;
            transition: all 0.25s ease;
        }
        
        .otp-input:focus {
            border-color: #C9A84C !important;
            box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.25);
            background-color: #121212;
            outline: none;
        }
        
        .btn-disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-fade-in {
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-obsidian min-h-screen text-ivory font-sans flex flex-col justify-between overflow-x-hidden">
    <!-- Header Navbar -->
    <nav class="border-b border-gold-light/10 bg-obsidian/90 backdrop-blur-md sticky top-0 z-50">
        <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center space-x-3 cursor-pointer" onclick="window.location.href='/'">
                    <img src="/img/Pasted image.png" alt="CaseCart Logo" class="h-9 w-auto object-contain rounded-lg shadow">
                    <span class="font-display text-2xl tracking-widest text-gold-light font-light uppercase">Case Cart</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Modal Card -->
    <div id="otp-verification" class="page active flex-grow flex items-center justify-center py-12 px-4 sm:px-6">
        <div class="max-w-md w-full animate-fade-in">
            <div class="bg-obsidian-light/95 border border-gold-light/15 rounded-3xl p-8 sm:p-10 shadow-2xl backdrop-blur-xl relative">
                <!-- Icon Header -->
                <div class="text-center mb-8">
                    <div class="w-14 h-14 border border-gold-light/20 bg-gold-light/10 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-inner text-gold-accent text-xl">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <span class="text-[10px] uppercase tracking-widest text-gold-accent font-semibold">Security Verification</span>
                    <h2 class="font-display text-3xl sm:text-4xl font-medium tracking-wide text-gold-light mt-1">Enter OTP</h2>
                    <p class="text-gray-400 text-xs mt-2">A 6-digit code has been sent to your email</p>
                    <p class="text-xs text-gold-accent mt-1 font-semibold" id="user-email">user@example.com</p>
                </div>

                <!-- Form -->
                <form onsubmit="verifyOTP(event)" class="space-y-6">
                    <div class="flex justify-center gap-2 sm:gap-3">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 1)" onkeydown="handleBackspace(event, 1)" id="otp-1" pattern="[0-9]" inputmode="numeric">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 2)" onkeydown="handleBackspace(event, 2)" id="otp-2" pattern="[0-9]" inputmode="numeric">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 3)" onkeydown="handleBackspace(event, 3)" id="otp-3" pattern="[0-9]" inputmode="numeric">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 4)" onkeydown="handleBackspace(event, 4)" id="otp-4" pattern="[0-9]" inputmode="numeric">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 5)" onkeydown="handleBackspace(event, 5)" id="otp-5" pattern="[0-9]" inputmode="numeric">
                        <input type="text" maxlength="1" class="otp-input" oninput="moveToNext(this, 6)" onkeydown="handleBackspace(event, 6)" id="otp-6" pattern="[0-9]" inputmode="numeric">
                    </div>

                    <!-- Timer Row -->
                    <div class="text-center">
                        <div class="inline-flex items-center space-x-1.5 text-xs text-gray-400 bg-obsidian-surface px-3 py-1.5 rounded-full border border-gold-light/10">
                            <i class="far fa-clock text-gold-accent text-xs"></i>
                            <span>Expires in <strong id="timer" class="font-mono text-gold-light font-bold">02:00</strong></span>
                        </div>
                    </div>

                    <!-- Verify Button -->
                    <button type="submit" id="verify-btn" 
                            class="w-full bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-600 hover:to-yellow-600 text-obsidian py-3.5 rounded-xl text-xs uppercase tracking-widest font-bold shadow-lg transform hover:-translate-y-0.5 transition duration-200"
                            onclick="verifyOTP(event)">
                        Verify OTP
                    </button>

                    <!-- Resend OTP -->
                    <p class="text-center text-xs text-gray-400 mt-6 tracking-wide">
                        Didn't receive code? 
                        <button type="button" onclick="resendOTP()" id="resend-btn" disabled class="text-gold-accent hover:text-gold-light font-semibold btn-disabled transition ml-1">
                            Resend OTP
                        </button>
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Bottom Spacing -->
    <div class="h-8"></div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="/js/api.js"></script>
    <script type="module" src="/js/user/otpValidator.js"></script>
</body>
</html>