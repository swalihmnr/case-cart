<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - CaseCart</title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&family=Inter:wght@300;400;500;600&display=swap');
        
        .input-focus:focus {
            border-color: #C9A84C !important;
            box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.2);
            background-color: #121212;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-fade-in {
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-obsidian min-h-screen text-ivory font-sans flex flex-col justify-between overflow-x-hidden">
    <!-- Header Navbar -->
    <nav class="border-b border-gold-light/10 bg-obsidian/90 backdrop-blur-md sticky top-0 z-50">
        <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center space-x-3 cursor-pointer" onclick="window.location.href='/'">
                    <img src="/img/Pasted image.png" alt="CaseCart Logo" class="h-9 w-auto object-contain rounded-lg shadow">
                    <span class="font-display text-2xl tracking-widest text-gold-light font-light uppercase">Case Cart</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Card -->
    <div id="reset-password" class="page active flex-grow flex items-center justify-center py-12 px-4 sm:px-6">
        <div class="max-w-md w-full animate-fade-in">
            <div class="bg-obsidian-light/95 border border-gold-light/15 rounded-3xl p-8 sm:p-10 shadow-2xl backdrop-blur-xl relative">
                <!-- Icon & Header -->
                <div class="text-center mb-8">
                    <div class="w-14 h-14 border border-gold-light/20 bg-gold-light/10 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-inner text-gold-accent text-xl">
                        <i class="fas fa-lock-open"></i>
                    </div>
                    <span class="text-[10px] uppercase tracking-widest text-gold-accent font-semibold">Secure Update</span>
                    <h2 class="font-display text-3xl sm:text-4xl font-medium tracking-wide text-gold-light mt-1">Reset Password</h2>
                    <p class="text-gray-400 text-xs mt-2">Create a new secure password for your account</p>
                </div>

                <form class="space-y-6" novalidate>
                    <!-- New Password -->
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-gold-light/80 mb-2 font-semibold">New Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gold-light/40 text-xs"></i>
                            </div>
                            <input type="password" id="new-password" required 
                                class="input-focus block w-full pl-10 pr-10 py-3 bg-obsidian border border-gold-light/10 rounded-xl focus:outline-none transition text-ivory placeholder-gray-600 text-sm" 
                                placeholder="••••••••">
                            <button type="button" onclick="togglePassword('new-password')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center">
                                <i class="fas fa-eye text-gold-light/40 hover:text-gold-accent transition text-xs"></i>
                            </button>
                        </div>
                        <p class="text-red-400 text-xs mt-1" id="Errmsg"></p>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-gold-light/80 mb-2 font-semibold">Confirm Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gold-light/40 text-xs"></i>
                            </div>
                            <input type="password" id="confirm-new-password" required 
                                class="input-focus block w-full pl-10 pr-10 py-3 bg-obsidian border border-gold-light/10 rounded-xl focus:outline-none transition text-ivory placeholder-gray-600 text-sm" 
                                placeholder="••••••••">
                            <button type="button" onclick="togglePassword('confirm-new-password')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center">
                                <i class="fas fa-eye text-gold-light/40 hover:text-gold-accent transition text-xs"></i>
                            </button>
                        </div>
                        <p class="text-red-400 text-xs mt-1" id="cnErrmsg"></p>
                        <p id="password-match-error" class="text-red-400 text-xs mt-1 hidden">Passwords do not match</p>
                    </div>

                    <!-- Reset Submit Button -->
                    <button type="submit" 
                        class="w-full bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-600 hover:to-yellow-600 text-obsidian py-3.5 rounded-xl text-xs uppercase tracking-widest font-bold shadow-lg transform hover:-translate-y-0.5 transition duration-200">
                        Reset Password
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Bottom Spacing -->
    <div class="h-8"></div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="/js/user/resetPassword.js"></script>
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }
    </script>
</body>
</html>