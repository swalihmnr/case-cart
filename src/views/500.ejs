<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 - Server Error | CaseCart</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Inter:wght@300;400;500;600;700&display=swap');
    
    .font-display { font-family: 'Cormorant Garamond', serif; }
    .font-sans { font-family: 'Inter', sans-serif; }
    
    .bg-obsidian { background-color: #0A0A0A; }
    .bg-obsidian-light { background-color: #121212; }
    .text-gold-light { color: #E8D5B0; }
    .text-gold-accent { color: #C9A84C; }
    .text-ivory { color: #F7F5F2; }
  </style>
</head>
<body class="bg-obsidian text-ivory font-sans min-h-screen flex items-center justify-center p-6 selection:bg-gold-accent selection:text-obsidian">
  <div class="max-w-lg w-full text-center space-y-6">
    <div class="w-20 h-20 mx-auto rounded-full bg-red-950/30 border border-red-500/20 flex items-center justify-center text-red-400">
      <i class="fas fa-exclamation-triangle text-3xl"></i>
    </div>
    
    <div class="space-y-2">
      <span class="text-[10px] uppercase tracking-widest text-gold-accent font-semibold">Error 500</span>
      <h1 class="font-display text-4xl sm:text-5xl font-light text-gold-light tracking-wide">
        Internal Server Error
      </h1>
      <p class="text-gray-400 text-xs sm:text-sm leading-relaxed max-w-sm mx-auto">
        Something went wrong on our end while processing your request. Please try again or return to the main store.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a href="/"
        class="w-full sm:w-auto bg-gold-light text-obsidian hover:bg-gold-accent px-8 py-3 rounded text-xs uppercase tracking-widest font-semibold transition duration-300 shadow-md">
        Back to Home
      </a>
      <a href="/order"
        class="w-full sm:w-auto px-8 py-3 border border-gold-light/10 text-gold-light hover:border-gold-accent hover:text-gold-accent rounded text-xs uppercase tracking-widest font-semibold transition">
        View Orders
      </a>
    </div>
  </div>
</body>
</html>
